# Validated at build and at runtime by src/lib/env/schema.ts. Keep this file in
# step with that schema. The placeholders below deliberately fail validation.

# Neon connection string for the `development` branch, never production
DATABASE_URL=your_development_branch_connection_string

# Clerk development-instance keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# Clerk sign-in redirects
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Seed script only (`just db-seed`): your Clerk development-instance user ID,
# which owns the seeded data. Find it under Users in the Clerk dashboard.
SEED_CLERK_USER_ID=your_clerk_user_id
